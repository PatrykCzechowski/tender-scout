{
  "realm": "tender-scout",
  "enabled": true,
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "notices:read",
      "description": "Read the stored notices",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tender-scout-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "documents:ask",
      "description": "Ask about the text of the tender documents",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tender-scout-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "tender-scout-web",
      "name": "Tender Scout web page",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5150/", "https://localhost:7150/"],
      "webOrigins": ["http://localhost:5150", "https://localhost:7150"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5150/##https://localhost:7150/",
        "use.refresh.tokens": "false"
      },
      "defaultClientScopes": [],
      "optionalClientScopes": ["notices:read", "documents:ask"]
    },
    {
      "clientId": "tender-scout-machine",
      "name": "Tender Scout machine access",
      "enabled": true,
      "publicClient": false,
      "secret": "local-only-machine-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [],
      "optionalClientScopes": ["notices:read", "documents:ask"]
    }
  ],
  "users": [
    {
      "username": "tester",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Tester",
      "email": "tester@example.com",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "local-only-password",
          "temporary": false
        }
      ]
    }
  ]
}
