    <ProjectReference Include="..\TenderScout.DocumentImport\TenderScout.DocumentImport.csproj" />
    <ProjectReference Include="..\TenderScout.MigrationService\TenderScout.MigrationService.csproj" />
    <ProjectReference Include="..\TenderScout.Worker\TenderScout.Worker.csproj" />
  </ItemGroup>
</Project>
