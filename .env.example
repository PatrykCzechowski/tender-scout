# Copy to .env next to docker-compose.yml and set only what you change; git ignores .env.
# Every line left empty or commented out keeps the default of docker-compose.yml.

# Ports on 127.0.0.1. The sign-in accepts the page on 15150 and on 25150 only.
#API_PORT=15150
#MCP_PORT=15151
#KEYCLOAK_PORT=18180

# Ollama, for the embeddings and, by default, the chat. host.docker.internal is this machine.
#OLLAMA_ENDPOINT=http://host.docker.internal:11434
#CHAT_MODEL=SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0
#AGENT_MODEL=SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M

# Hosted chat instead: uncomment the four lines and paste the key. The embeddings stay on Ollama.
#CHAT_PROVIDER=OpenRouter
#CHAT_ENDPOINT=https://openrouter.ai/api/v1
#CHAT_MODEL=openai/gpt-4.1-mini
#AGENT_MODEL=openai/gpt-4.1-mini
OPENROUTER_API_KEY=

# True fetches real notices from TED every hour and mixes them into the demo.
#INGESTION_ENABLED=false
